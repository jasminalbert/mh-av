\SweaveOpts{concordance=TRUE}

\begin{equation}
\frac{dN_i}{dt} = r_i g_i N_i \left(1 - \alpha_{ii} g_i N_i - \alpha_{ij} g_j N_j \right)\label{LVeq}
\end{equation}

\begin{equation}
\frac{dN_1}{dt} = r_1 g_1 N_1 \left(1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 \right)
\end{equation}
\begin{equation}
\frac{dN_2}{dt} = r_2 g_2 N_2 \left(1 - \alpha_{21} g_1 N_1 - \alpha_{22} g_2 N_2 \right)
\end{equation}

\noindent Find the equilibria of the system.\newline \newline
Step 1: Set the derivatives to zero \newline



$\frac{dN_1}{dt} = 0$ if either: \newline


\indent \indent $N_1 = 0$, or \newline


\indent \indent $1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 = 0$ \newline


$\frac{dN_2}{dt} = 0$ if either: \newline


\indent \indent $N_2 = 0$, or \newline


\indent \indent $1 - \alpha_{21} g_1 N_1 - \alpha_{22} g_2 N_2 = 0$ \newline


\noindent Step 2: List all possible equilibria \newline

(1) Trivial Equilibrium \newline

\indent\indent$N_1 = 0$,$\quad N_2 = 0$ \newline

(2) Species 1 Only (Species 2 extinct) \newline

\indent\indent Set $N_2 = 0$, solve: \newline

\indent\indent $1 - \alpha_{11} g_1 N_1 = 0 \Rightarrow N_1^* = \frac{1}{\alpha_{11} g_1}$ \newline

\indent\indent So: $(N_1^*, N_2^*) = \left( \frac{1}{\alpha_{11} g_1},\ 0 \right)$ \newline

(3) Species 2 Only (Species 1 extinct) \newline

\indent\indent Set $N_1 = 0$, solve:\newline

\indent\indent $1 - \alpha_{22} g_2 N_2 = 0 \Rightarrow N_2^* = \frac{1}{\alpha_{22} g_2}$ \newline

\indent\indent So: $(N_1^*, N_2^*) = \left( 0,\ \frac{1}{\alpha_{22} g_2} \right)$\newline

(4) Coexistence Equilibrium\newline

Now solve the system:\newline
\begin{equation}
1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 = 0 \label{eq:1} 
\end{equation}
\begin{equation}
1 - \alpha_{21} g_1 N_1 - \alpha_{22} g_2 N_2 = 0 \label{eq:2}
\end{equation}

\noindent You can solve this as a linear system in $N_1$ and $N_2$:

From eq. \ref{eq:1}: 
\begin{equation}
\alpha_{11} g_1 N_1 + \alpha_{12} g_2 N_2 = 1\label{eq:1'}
\end{equation}
\indent From eq. \ref{eq:2}:
\begin{equation}
\alpha_{21} g_1 N_1 + \alpha_{22} g_2 N_2 = 1\label{eq:2'}
\end{equation}
Now solve using linear algebra:

Let’s solve for $N_1$ and $N_2$: \newline

Multiply \ref{eq:1'} by $\alpha_{22}$, and \ref{eq:2'} by $\alpha_{12}$: \newline

\indent\indent$\alpha_{11} \alpha_{22} g_1 N_1 + \alpha_{12} \alpha_{22} g_2 N_2 = \alpha_{22}$ \newline


\indent\indent$\alpha_{21} \alpha_{12} g_1 N_1 + \alpha_{12} \alpha_{22} g_2 N_2 = \alpha_{12}$ \newline


Now subtract the two: \newline

\indent\indent$(\alpha_{11} \alpha_{22} - \alpha_{21} \alpha_{12}) g_1 N_1 = \alpha_{22} - \alpha_{12}$ \newline

So, $N_1^* = \frac{\alpha_{22} - \alpha_{12}}{g_1 (\alpha_{11} \alpha_{22} - \alpha_{12} \alpha_{21})}$ \newline

Plug into eq. \ref{eq:1'} to solve for $N_2^*$: \newline

\indent\indent$N_2^* = \frac{\alpha_{11} - \alpha_{21}}{g_2 (\alpha_{11} \alpha_{22} - \alpha_{12} \alpha_{21})}$ \newline

Final Answer: Coexistence Equilibrium \newline

\indent\indent$N_1^* = \frac{\alpha_{22} - \alpha_{12}}{g_1 (\alpha_{11} \alpha_{22} - \alpha_{12} \alpha_{21})} \quad,\quad N_2^* = \frac{\alpha_{11} - \alpha_{21}}{g_2 (\alpha_{11} \alpha_{22} - \alpha_{12} \alpha_{21})}$


\section{Zero Net Growth Isoclines}
Computed by setting the population growth of a species to zero, $dN_i/dt=0$, 
and calculating 
the population size of the other species. 
From eq. \ref{LVeq}, 
\begin{equation}
0=r_ig_iN_i(1-\alpha_{ii}g_iN_i-\alpha_{ij}g_jN_j)
\end{equation}

$(1-\alpha_{ii}g_iN_i-\alpha_{ij}g_jN_j)=0$ %N_i zero growth

$\alpha_{ii}g_iN_i=1-\alpha_{ij}g_jN_j$ %N_i when i has zero growth

\begin{equation}
N_i = \left(\frac{1-\alpha_{ij}g_jN_j}{\alpha_{ii}g_i}\right)
\end{equation}

%\alpha_{ij}g_jN_j = 1-\alpha_{ii}g_iN_i
Intercepts of species $i$ isocline are

\noindent$N_i=\frac{1}{\alpha_{ii}g_i}$, when $N_j=0$, and

\noindent$N_j=\frac{1}{\alpha_{ij}g_j}$, when $N_i=0$.

From eq. \ref{LVeq}, 
\begin{equation}
0=r_jg_jN_j(1-\alpha_{jj}g_jN_j-\alpha_{ji}g_iN_i)
\end{equation}

$(1-\alpha_{jj}g_jN_j-\alpha_{ji}g_iN_i)=0$ %zero growth for j

$\alpha_{jj}g_jN_j=1-\alpha_{ji}g_iN_i$ %N_j when j has zero growth

$\alpha_{ji}g_iN_i=1-\alpha_{jj}g_jN_j$ %N_i when j has zero growth

\begin{equation}
N_j = \left(\frac{1-\alpha_{ji}g_iN_i}{\alpha_{jj}g_j}\right)
\end{equation}

Intercepts of species $j$ isocline are

\noindent$N_i=\frac{1}{\alpha_{ji}g_i}$, when $N_j=0$, and

\noindent$N_j=\frac{1}{\alpha_{jj}g_j}$, when $N_i=0$.


\section*{Do ZNGIs Differ in Discrete-Time Models?}

\textbf{Short Answer:} Yes, the \emph{net zero growth isoclines (ZNGIs)} can differ in form and location in a \textbf{discrete-time} version of the Lotka-Volterra competition model compared to the continuous-time model. This is especially true when growth rates or competition coefficients are large.

\subsection*{1. Continuous-Time Model}

The continuous-time Lotka-Volterra competition model with germination is:

\[
\frac{dN_1}{dt} = r_1 g_1 N_1 \left(1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 \right)
\]

Setting growth to zero (\( \frac{dN_1}{dt} = 0 \)), we get:

\[
1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 = 0
\Rightarrow
N_1 = \frac{1 - \alpha_{12} g_2 N_2}{\alpha_{11} g_1}
\]

This is the ZNGI for species 1, and it does \emph{not} depend on \( r_1 \).

\subsection*{2. Discrete-Time Model}

The discrete-time version of the model is:

\[
N_{1,t+1} = N_{1,t} \cdot \lambda_1 \cdot g_1 \cdot \left(1 - \alpha_{11} g_1 N_{1,t} - \alpha_{12} g_2 N_{2,t} \right)
\]

For zero growth, we set:    

\[
\frac{N_{1,t+1}}{N_{1,t}} = 1
\Rightarrow
\lambda_1 g_1 \left(1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 \right) = 1
\]

Solving for the ZNGI:

\[
1 - \alpha_{11} g_1 N_1 - \alpha_{12} g_2 N_2 = \frac{1}{\lambda_1 g_1}
\Rightarrow
\alpha_{11} g_1 N_1 + \alpha_{12} g_2 N_2 = 1 - \frac{1}{\lambda_1 g_1}
\Rightarrow
N_1 = \frac{1 - \frac{1}{\lambda_1 g_1} - \alpha_{12} g_2 N_2}{\alpha_{11} g_1}
\]

This differs from the continuous-time case because it \emph{does} depend on \( \lambda_1 \) (and hence \( r_1 \)).

\subsection*{3. Key Implications}

\begin{itemize}
  \item In discrete time, species persistence requires \( \lambda_i g_i > 1 \).
  \item ZNGIs shift depending on \( \lambda \), potentially altering coexistence conditions.
  \item No ZNGI exists for species \( i \) if \( \lambda_i g_i < 1 \); it declines even without competition.
\end{itemize}

\subsection*{4. Summary Table}

\begin{table}[h]
\centering
\begin{tabular}{@{}lll@{}}
\toprule
\textbf{Feature} & \textbf{Continuous Time} & \textbf{Discrete Time} \\ \midrule
ZNGI depends on \( r \)? & No & Yes (via \( \lambda \)) \\
ZNGI linear in \( N_i, N_j \)? & Yes & Yes (but intercept shifts) \\
Sensitive to extinction risk? & Less so & More so if \( \lambda g < 1 \) \\
\bottomrule
\end{tabular}
\end{table}

Population simulations should theoretically follow discrete time dynamics 
but that doesnt seem to be the case. 
Populations stabalize at equilibria expected under continuous time models.

\section{Dispersal}
Under priority effects (inter>intra), there is no coexistence. But when a small amount of dispersal
is allowed populations reach their coexistence equilibrias. 



\section*{Equilibrium Analysis of the Discrete-Time Lotka-Volterra Competition Model with Germination}

We consider the following model for two competing species with discrete-time dynamics:

\[
N_{1,t+1} = N_{1,t} \cdot \lambda_1 g_1 \left(1 - \alpha_{11} g_1 N_{1,t} - \alpha_{12} g_2 N_{2,t} \right)
\]
\[
N_{2,t+1} = N_{2,t} \cdot \lambda_2 g_2 \left(1 - \alpha_{22} g_2 N_{2,t} - \alpha_{21} g_1 N_{1,t} \right)
\]

\subsection*{Equilibrium Conditions}

At equilibrium, population sizes do not change from one time step to the next:

\[
N_{1,t+1} = N_{1,t} = N_1^*, \quad N_{2,t+1} = N_{2,t} = N_2^*
\]

Dividing both sides of each equation by \( N_i^* \), we get:

\[
\lambda_1 g_1 \left(1 - \alpha_{11} g_1 N_1^* - \alpha_{12} g_2 N_2^* \right) = 1
\]
\[
\lambda_2 g_2 \left(1 - \alpha_{22} g_2 N_2^* - \alpha_{21} g_1 N_1^* \right) = 1
\]

\subsection*{Solving the System}

Rewriting the equations:

\[
\alpha_{11} g_1^2 N_1^* + \alpha_{12} g_1 g_2 N_2^* = 1 - \frac{1}{\lambda_1 g_1}
\]
\[
\alpha_{21} g_1 g_2 N_1^* + \alpha_{22} g_2^2 N_2^* = 1 - \frac{1}{\lambda_2 g_2}
\]

This is a system of two linear equations in \( N_1^* \) and \( N_2^* \). We can write it in matrix form:

\[
\begin{bmatrix}
\alpha_{11} g_1^2 & \alpha_{12} g_1 g_2 \\
\alpha_{21} g_1 g_2 & \alpha_{22} g_2^2
\end{bmatrix}
\begin{bmatrix}
N_1^* \\
N_2^*
\end{bmatrix}
=
\begin{bmatrix}
1 - \frac{1}{\lambda_1 g_1} \\
1 - \frac{1}{\lambda_2 g_2}
\end{bmatrix}
\]

We solve this system using standard linear algebra (e.g., matrix inversion or Cramer's rule) to obtain the equilibrium densities \( N_1^* \) and \( N_2^* \), provided the solution yields non-negative values.

\subsection*{Full Solution for }%\texorpdfstring{$(N_1^*, N_2^*)$}{(N1*, N2*)}}

To solve the equilibrium system:

\[
\begin{aligned}
\lambda_1 g_1 \left(1 - \alpha_{11} g_1 N_1^* - \alpha_{12} g_2 N_2^* \right) &= 1 \\
\lambda_2 g_2 \left(1 - \alpha_{21} g_1 N_1^* - \alpha_{22} g_2 N_2^* \right) &= 1
\end{aligned}
\]

We first rewrite the system as:

\[
\begin{aligned}
\alpha_{11} g_1^2 N_1^* + \alpha_{12} g_1 g_2 N_2^* &= 1 - \frac{1}{\lambda_1 g_1} \\
\alpha_{21} g_1 g_2 N_1^* + \alpha_{22} g_2^2 N_2^* &= 1 - \frac{1}{\lambda_2 g_2}
\end{aligned}
\]

This is a linear system of the form:

\[
\begin{bmatrix}
A & B \\
C & D
\end{bmatrix}
\begin{bmatrix}
N_1^* \\
N_2^*
\end{bmatrix}
=
\begin{bmatrix}
R_1 \\
R_2
\end{bmatrix}
\]

where:

\[
\begin{aligned}
A &= \alpha_{11} g_1^2, \quad B = \alpha_{12} g_1 g_2 \\
C &= \alpha_{21} g_1 g_2, \quad D = \alpha_{22} g_2^2 \\
R_1 &= 1 - \frac{1}{\lambda_1 g_1}, \quad R_2 = 1 - \frac{1}{\lambda_2 g_2}
\end{aligned}
\]

Using Cramer's rule, the solution is:

\[
N_1^* = \frac{R_1 D - B R_2}{AD - BC}, \qquad
N_2^* = \frac{A R_2 - R_1 C}{AD - BC}
\]

Substituting the definitions back in, we get:

\[
N_1^* = \frac{
\left(1 - \frac{1}{\lambda_1 g_1}\right) \alpha_{22} g_2^2 - \alpha_{12} g_1 g_2 \left(1 - \frac{1}{\lambda_2 g_2} \right)
}{
\alpha_{11} g_1^2 \alpha_{22} g_2^2 - \alpha_{12} \alpha_{21} g_1^2 g_2^2
}
\]

\[
N_2^* = \frac{
\alpha_{11} g_1^2 \left(1 - \frac{1}{\lambda_2 g_2} \right) - \left(1 - \frac{1}{\lambda_1 g_1} \right) \alpha_{21} g_1 g_2
}{
\alpha_{11} g_1^2 \alpha_{22} g_2^2 - \alpha_{12} \alpha_{21} g_1^2 g_2^2
}
\]

These expressions provide the exact coexistence equilibrium of the two-species discrete-time competition model, assuming the denominator is non-zero and both values are positive.

\subsection*{Discrete-Time Model Forms: Multiplicative vs. Additive}

In discrete-time population models, there are two common ways to represent dynamics: the \textit{multiplicative} form and the \textit{additive} form. The choice between these reflects both mathematical intent and biological assumptions.

\subsubsection*{1. Multiplicative Form (Geometric Growth)}

This form assumes per capita reproduction is multiplicative, as in:

\[
N_{t+1} = N_t \cdot \lambda \cdot \text{(competition term)}
\]

For a two-species competition model with germination, this becomes:

\[
N_{1,t+1} = N_{1,t} \cdot \lambda_1 g_1 \left(1 - \alpha_{11} g_1 N_{1,t} - \alpha_{12} g_2 N_{2,t} \right)
\]

This form is biologically meaningful for species with seasonal or pulsed reproduction, such as annual plants. It ensures non-negative values for $N_t$ and leads to a clean equilibrium condition:
\[
\lambda_i g_i \left(1 - \sum_j \alpha_{ij} g_j N_j^* \right) = 1
\]

\textbf{Advantages:}
\begin{itemize}
  \item Interpretable as discrete reproductive output per individual.
  \item Well-behaved dynamics with fewer numerical artifacts.
  \item Matches classical ecological theory (e.g., Chesson, Tilman).
\end{itemize}

\subsubsection*{2. Additive Form (Euler Approximation of Continuous-Time)}

Alternatively, some models use an additive update, mimicking a forward Euler step of a differential equation:

\[
N_{t+1} = N_t + r \cdot N_t \cdot \text{(competition term)}
\]

\[
N_{1,t+1} = N_{1,t} + r_1 g_1 N_{1,t} \left(1 - \alpha_{11} g_1 N_{1,t} - \alpha_{12} g_2 N_{2,t} \right)
\]

This form is useful when approximating continuous-time dynamics using discrete steps. However, for large growth rates or time steps, it can produce negative or unstable dynamics.

\textbf{Disadvantages:}
\begin{itemize}
  \item Requires small $r$ or time steps to remain stable.
  \item Can yield negative population sizes.
  \item Less natural for organisms with distinct reproductive events.
\end{itemize}

\subsubsection*{Recommendation}

For our purposes—modeling annual plants with seasonal reproduction and priority effects—the \textbf{multiplicative model form} is the more appropriate choice. It better captures the biology of discrete-time, generation-based reproduction and supports tractable equilibrium and invasion analysis consistent with classical competition theory.

\[
N_{t+1} = N_t \cdot \lambda g (1 - \alpha_{11} g N_1 - \alpha_{12} g N_2)
\]

We therefore use the multiplicative form throughout this analysis.

\subsection*{Recommended References on Discrete-Time Model Forms}

The choice between multiplicative and additive discrete-time models is well-covered in both theoretical and applied ecological literature. The following references provide guidance on their formulation, interpretation, and use:
\subsubsection{Foundational and Theoretical}
\begin{itemize}
    \item Kot, M. (2001). \textit{Elements of Mathematical Ecology}. Cambridge University Press.  
    \begin{itemize}
        \item Chapter 3 provides a clear treatment of discrete-time models, including both multiplicative (geometric) and additive (Euler-approximated) forms. 
        \item dicusses discrete-time models, especially \textbf{geometric growth} vs 
        \textbf{logistic-like} updates
        \item explains when to use Euler approximation vs multiplicative models
        \item very readable, with examples of both model types
    \end{itemize}

    \item May, R. M. (1976). Simple mathematical models with very complicated dynamics. \textit{Nature}, \textbf{261}(5560), 459–467.  
    \begin{itemize}
        \item A foundational study on the chaotic dynamics of additive logistic growth models.
        \item THE classic paper on discrete-time population models
        \item shows chaotic behavior from additive logistic models
        \item lays groundwork for why \textbf{multiplicative models} are more stable biologically
    \end{itemize}

    \item Hastings, A. (1997). \textit{Population Biology: Concepts and Models}. Springer.  
    \begin{itemize}
        \item Discusses discrete-time population models and their dynamical behavior under different formulations.
        \item includes both forms and discusses their implications for stability and biological realism
    \end{itemize}
\end{itemize}

\subsubsection{Ecology and Competition Theory}
\begin{itemize}
    \item Tilman, D. (1994). Competition and biodiversity in spatially structured habitats. \textit{Ecology}, \textbf{75}(1), 2–16.  
    \begin{itemize}
        \item Uses discrete multiplicative models for plant competition in annual systems.
        \item justifies them for annual apecies and pulsed recruitment
    \end{itemize}

    \item Chesson, P. (2000). Mechanisms of maintenance of species diversity. \textit{Annual Review of Ecology and Systematics}, \textbf{31}, 343–366.  
    \begin{itemize}
        \item While focused on continuous models, provides theoretical justification for discrete models with pulsed reproduction.
        \item frames models in a way that supports the use of multiplicative terms when discrete-time structure is assumed
    \end{itemize}

    \item Armstrong, R. A., \& McGehee, R. (1980). Competitive exclusion. \textit{The American Naturalist}, \textbf{115}(2), 151–170.  
    \begin{itemize}
        \item Provides mathematical background on competitive dynamics across both model types.
        \item discrete vs continuous and geometric vs linear growth
    \end{itemize}
\end{itemize}
\subsubsection{For Annual Plants and Priority Effects}
\begin{itemize}
    \item Adler, P. B., HilleRisLambers, J., \& Levine, J. M. (2007). A niche for neutrality. \textit{Ecology Letters}, \textbf{10}(2), 95–104.  
    \begin{itemize}
        \item Demonstrates the application of discrete multiplicative models to annual plant communities.
        \item good ecological interpretation with clear dynamics
    \end{itemize}

    \item Mordecai, E. A. (2011). Pathogen impacts on plant communities: unifying theory, concepts, and empirical work. \textit{Ecological Monographs}, \textbf{81}(3), 429–441.  
    \begin{itemize}
        \item Uses discrete-time models in a realistic annual plant-pathogen context.
        \item applies multiplicative models to annual grasslands and priority effects
        \item shows how demographic timing matters
    \end{itemize}

    \item Ke, P.-J., \& Letten, A. D. (2018). Coexistence theory and the frequency-dependence of priority effects. \textit{Nature Ecology \& Evolution}, \textbf{2}(11), 1691–1695.  
    \begin{itemize}
        \item focuses on coexistence and priority effects
        \item Discusses modeling approaches for priority effects in annual systems.
        \item discusses modeling choices (though not formal comparison of model forms)
    \end{itemize}
\end{itemize}

