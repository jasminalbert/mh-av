\section{Diffusion}

Let $N_i(x,t)$ be the abundance of species $i$ in cell $x$ at time $t$,  
$D_i$ the proportion of the population dispersing per time step,  
$E(x)$ the environmental value at cell $x$,  
$\theta$ the bias strength parameter,  
and $\mathcal{N}(x)$ the set of neighboring cells of $x$.

Let:
\begin{itemize}
    \item $N_i(x,t)$ = abundance of species $i$ in cell $x$ at time $t$
    \item $D_i$ = fraction of the population dispersing per time step
    \item $E(x)$ = environmental value at cell $x$
    \item $\theta$ = bias strength parameter
    \item $\mathcal{N}(x)$ = set of neighboring cells of $x$
    \item $\mathcal{N}(o)$ = set of neighboring cells of origin $o$ (can include $o$ itself if self-retention is allowed)
\end{itemize}

\paragraph{1. Destination weights}
For each destination cell $d \in \mathcal{N}(o)$ of origin cell $o$, assign an unnormalized weight:
\[
w(d) = \exp\big( \theta \, E(d) \big).
\]

\paragraph{2. Movement probability}
The probability of moving from origin $o$ to destination $d$ is:
\[
p_{o \to d} = \frac{w(d)}{\sum\limits_{y \in \mathcal{N}(o)} w(y)}
= \frac{\exp\big( \theta E(d) \big)}
{\sum\limits_{y \in \mathcal{N}(o)} \exp\big( \theta E(y) \big)}.
\]

Note that:
\[
\sum_{d \in \mathcal{N}(o)} p_{o \to d} = 1
\]
for each origin $o$.

\paragraph{3. Biased diffusion update}
The biased diffusion step for species $i$ is:
\[
N_i(x, t+1) = (1 - D_i) \, N_i(x, t) 
+ D_i \sum_{o \in \mathcal{N}(x)} N_i(o, t) \, p_{o \to x}.
\]

Substituting $p_{o \to x}$:
\[
N_i(x, t+1) = (1 - D_i) \, N_i(x, t) 
+ D_i \sum_{o \in \mathcal{N}(x)} 
\frac{N_i(o, t) \, \exp\big( \theta E(x) \big)}
{\sum\limits_{y \in \mathcal{N}(o)} \exp\big( \theta E(y) \big)}.
\]

\textbf{English explanation:}

For each patch $x$, there are neighbors $o$, that are the \emph{origin} of inflow to $x$. 
The inflow to $x$ is, for each possible neighboring origin
$o$, the population density of $o$ weighted by the 
environmental attraction of $x$ [$\exp(\theta E(x))$] that is 
scaled by the environmental attraction of the neighbors of 
$o$. Note that when $\theta=0$, $p$ is uniform across neighbors and dispersal is unbiased.

\subsection{Litter}

As of now, litter in the next time step is simply the sum of scalar multiples of density in the previous time step.

\[
L(x,t) = l_1N_1(x,t-1) + l_2N_2(x,t-1)
\]

The environment is determined by litter differences:
\[
\Delta_L(x,t) = \sum_{x' \in \mathcal{N}(x)}L(x',t)-L(x,t)
\]
So a negative $\Delta_L(x)$ mean that $x$ has more litter than 
neighbors $x'$. 

\noindent To amplify the differences in diffusion, $E$ is the rank of $-\Delta_L$.

\[
E(x,t) = \text{rank} (-\Delta_L(x,t))
\]

why did I rank litter differences instead of just ranking the litter itself..? That would produce the same result I think. Well litter differences is first used in modifying $\lambda_1$ and I was first just using $E=-\Delta_L$ but it wasnt making strong enough differences. $E=L$ even smaller because the values are closer together. 

\subsubsection{Litter and $\lambda$}
Litter boosts $\lambda$ in species $1$. Let $\lambda_i^0$ be the baseline seed production without litter dynamics. With litter dynamics,
\[
\lambda_i = \lambda_i^0 \exp \big(-\rho \Delta_L \big)
\]

\section{Full model}

Let $f_i()$ be the seed production and competition function,
\begin{align}
f_1(N_1,N_2) &= N_1 \lambda_1(1-N_1-\alpha N_2)\\
f_2(N_1,N_2) &= N_2 \lambda_2(1-N_2-\beta N_1)
\end{align}

where germinants grow, compete, and make new seeds (or germinants?).

The seeds/germinants then disperse, so,
\begin{equation}
%N_i(x,t+1) = f\big(N_i(x,t)\big) 
N_i(x, t+1) = (1 - D_i) \, f_i\big(\mathbf{N}(x, t) \big) 
+ D_i \sum_{o \in \mathcal{N}(x)} 
\frac{f_i\big(\mathbf{N}(o, t) \big)\, \exp\big( \theta E(x,t) \big)}
{\sum\limits_{y \in \mathcal{N}(o)} 
\exp\big( \theta E(y,t) \big)}
\end{equation}
\newline

Expanded: (let $\beta_{ij} = \left[\alpha , \beta \right]$)
\begin{align}
N_i(x,t+1) &= (1-D_i)\,\lambda_i\,N_i(x,t)\Big(1-\sum_j \beta_{ij}N_j(x,t)\Big) \\
&\quad + D_i \sum_{o\in\mathcal{N}(x)}
\left[
\frac{\exp\theta E(x,t)}{\sum\limits_{y\in\mathcal{N}(o)} \exp\theta E(y,t)}
\; \lambda_i\,N_i(o,t)\Big(1-\sum_j \beta_{ij}N_j(o,t)\Big)
\right].\nonumber
\end{align}
\newline

\begin{align}
E(x,t) &= E(\boldsymbol{l} \cdot \mathbf{N}(x,t-1)) = \text{rank}\left[-\sum_{x' \in \mathcal{N}(x)}L(x',t)-L(x,t) \right]\\
&=\text{rank}\left[-\sum_{x' \in \mathcal{N}(x)} l_1N_1(x',t-1) + l_2N_2(x',t-1)-l_1N_1(x,t-1) - l_2N_2(x,t-1)\right]\nonumber
\end{align}
\newline

\begin{align}
\lambda_1 = \lambda_1^0 \,\, \exp -\Delta_L \, \rho_1 \\
\theta_1 = 0 \quad \rho_2 = 0
\end{align}

