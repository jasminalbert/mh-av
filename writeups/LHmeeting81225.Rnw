\section{Lokta-Volterra model with germination (previous model)}

$N_{1,t+1} = N_{1,t} \cdot \lambda_1 \cdot g_1 \cdot \left(1 - \alpha_{11} g_1 N_{1,t} - \alpha_{12} g_2 N_{2,t} \right)$\newline

\noindent With exponential half life litter cohort tracking and accumulation 
and simple dispersal

\subsection{What changed}
\begin{itemize}
\item non-dimensionalized alphas
\item took out $g$'s
\item no litter accumulation
\item dispersal is environmentally (litter) biased diffusion
\item $\lambda$ boost is also based on litter differences
\end{itemize}

\section{New non-dimensionalized model}
\begin{align}
N_{1,t+1} &= N_{1,t} \cdot \lambda_1 \cdot \left(1 - N_{1,t} - \alpha \cdot N_{2,t} \right), \\
N_{2,t+1} &= N_{2,t} \cdot \lambda_2 \cdot \left(1 - N_{2,t} - \beta \cdot N_{1,t} \right),
\end{align}

where:
\[
\alpha = \frac{\alpha_{12}}{\alpha_{22}}, \qquad \beta = \frac{\alpha_{21}}{\alpha_{11}}.
\]

\subsection{Equilibria}
Four possible equilibria:

\begin{itemize}
  \item \textbf{Extinction}: $(N_1^*, N_2^*) = (0, 0)$.
  \item \textbf{Species 1 only}: if $\lambda_1 > 1$, then
  \[
  (N_1^*, N_2^*) = \left(1 - \frac{1}{\lambda_1}, 0\right).
  \]
  \item \textbf{Species 2 only}: if $\lambda_2 > 1$, then
  \[
  (N_1^*, N_2^*) = \left(0, 1 - \frac{1}{\lambda_2} \right).
  \]
  \item \textbf{Coexistence} (both species present): 
  Then back-substitute to get $N_1^*$.
  \[
  (N_1^*, N_2^*) = \big(\frac{1 - \frac{1}{\lambda_1}- \alpha(1 - \frac{1}{\lambda_2})}
  {1 + \beta \alpha}, 
  \frac{1- \frac{1}{\lambda_2}- \beta(1 - \frac{1}{\lambda_1})}
  {1 + \beta \alpha} \big).
  \]
  %\[
  %(N_1^*, N_2^*) = \big(\frac{ \frac{\lambda_1-1}{\lambda_1}
  %-\alpha \frac{\lambda_2 -1}{\lambda_2}}{1 + \beta \alpha}, 
  %\frac{\frac{\lambda_2-2}{\lambda_2}-\beta \frac{\lambda_1 -1}{\lambda_1}}
  %{1 + \beta \alpha} \big).
  %\]
\end{itemize}
  %numerator <- 1 - beta21 * (1 - 1/lambda1) - 1/lambda2
  
  %numerator <- (lambda1-1)/lambda1 - beta12*(lambda2-1)/lambda2
  
Coexistence requires $N_1^* > 0$ and $N_2^* > 0$, which occurs when interspecific competition is sufficiently weak and both species have $\lambda_i > 1$.
\newline
\noindent See \ref{section:ndm deriv} for derivation of model and equilibriums.

